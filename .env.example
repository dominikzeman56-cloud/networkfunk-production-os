# NPOS Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# ── Required for AI mentor ──
ANTHROPIC_API_KEY=your_api_key_here

# ── API server ──
# Canonical port is 3099 (also set in npos.config.json → server.port)
PORT=3099
NPORT=3099
NODE_ENV=development

# ── Web frontend ──
# API base URL for browser-side fetch calls (used by Web/.env and client scripts)
PUBLIC_API_URL=http://localhost:3099

# Optional AI model override (default from npos.config.json → ai.model)
# NPOS_AI_MODEL=claude-sonnet-4-20250514

# ── Optional external tools ──
# Audio analyzer binary (or set audioAnalyzer.binPath in npos.config.json)
# AUDIO_ANALYZER_BIN=C:/Users/YOU/AppData/Local/audio-analyzer-mcp/server/mcp-server.exe

# Paths below are optional overrides; prefer npos.config.json → external.*
# NEUROMAN_PATH=
# OBSIDIAN_VAULT_PATH=
