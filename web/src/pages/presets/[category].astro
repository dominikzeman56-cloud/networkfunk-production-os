---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const categories = ['bass', 'lead', 'fx', 'pad', 'texture'];
  return categories.map(category => ({ params: { category } }));
}

const { category } = Astro.params;
const categoryMap: Record<string, string> = {
  bass: 'Basy', lead: 'Ledy', fx: 'Efekty', pad: 'Pady', texture: 'Textury',
};
const label = categoryMap[category as string] || category;

const presets: any[] = [];
// Presety se budou načítat podle kategorie
---

<Layout title={`Předlohy - ${label}`} module="PRESETS">
    <div class="hud-page-head">
        <div>
            <div class="hud-eyebrow">SERUM PRESET ANALYSIS</div>
            <div class="hud-page-title">{label}</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px;">
        {presets.map((p: any) => (
            <div class="card elev-sm">
                <span class="card-title" style="font-size: 13px;" title={p.name}>{p.name}</span>
                <span class="tag tag-neutral" style="align-self: flex-start;">{p.version}</span>
            </div>
        ))}
        {presets.length === 0 && <p class="text-muted">Zatím žádné presety v této kategorii — analýza podle kategorie ještě není napojená.</p>}
    </div>
</Layout>
