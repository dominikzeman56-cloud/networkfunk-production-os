---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const serum1Path = 'D:/VST/Xfer/Serum Presets/Presets';
const serum2Path = 'D:/VST/Xfer/Serum 2 Presets/Presets';

function loadPresets(dir: string, version: string): any[] {
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir)
    .filter(f => f.endsWith('.serum') || f.endsWith('.xsr'))
    .slice(0, 20)
    .map(f => ({
      name: f.replace(/\.serum$/i, '').replace(/\.xsr$/i, ''),
      version,
      path: path.join(dir, f)
    }));
}

const presets = [
  ...loadPresets(serum1Path, 'Serum 1'),
  ...loadPresets(serum2Path, 'Serum 2')
].slice(0, 30);

const categories = [
  { name: 'Basy', slug: 'bass' },
  { name: 'Ledy', slug: 'lead' },
  { name: 'Efekty', slug: 'fx' },
  { name: 'Pady', slug: 'pad' },
  { name: 'Textury', slug: 'texture' },
];
---

<Layout title="Předlohy" module="PRESETS">
    <div class="hud-page-head">
        <div>
            <div class="hud-eyebrow">SERUM PRESET ANALYSIS</div>
            <div class="hud-page-title">Presety</div>
        </div>
    </div>

    <div class="hud-panel" style="margin-bottom: 20px;">
        <div style="display: flex; gap: 10px;">
            <input type="text" placeholder="Hledat preset..." class="input" style="flex: 1;">
            <button class="btn btn-primary">Hledat</button>
        </div>
    </div>

    <div class="hud-panel-label" style="margin-bottom: 12px;">KATEGORIE</div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 12px; margin-bottom: 24px;">
        {categories.map(cat => (
            <a href={`/presets/${cat.slug}`} class="card elev-sm" style="text-decoration: none; color: inherit; text-align: center; align-items: center;">
                <span class="card-title" style="font-size: 14px;">{cat.name}</span>
            </a>
        ))}
    </div>

    <div class="hud-panel-label" style="margin-bottom: 12px;">POSLEDNÍ PŘIDANÉ PRESETY</div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px;">
        {presets.slice(0, 18).map(p => (
            <div class="card elev-sm">
                <span class="card-title" style="font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={p.name}>{p.name}</span>
                <span class="tag tag-neutral" style="align-self: flex-start;">{p.version}</span>
            </div>
        ))}
        {presets.length === 0 && <p class="text-muted">Žádné presety nenalezeny — zkontroluj cestu k Serum knihovně.</p>}
    </div>
</Layout>
