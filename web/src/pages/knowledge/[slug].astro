---
// Dynamic route for knowledge pages
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { parseMarkdownString } from '../../lib/markdown';

export async function getStaticPaths() {
  const knowledgeDir = 'D:/ObsidianVault/networkfunk-production-os/Knowledge';
  return fs.readdirSync(knowledgeDir).filter(f => f.endsWith('.md')).map(f => {
    const filePath = path.join(knowledgeDir, f);
    const parsed = parseMarkdownString(fs.readFileSync(filePath, 'utf8'), filePath);
    const page = { slug: f.replace('.md', ''), title: parsed.title, content: parsed.content };
    return { params: { slug: page.slug }, props: { page } };
  });
}

const { page } = Astro.props;
---

<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page?.title} - NPOS</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <style>
        :root { --primary: #10b981; --primary-hover: #059669; }
        body { background-color: #0f172a; color: #f1f5f9; font-family: system-ui, sans-serif; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-gray-800 border-b border-gray-700 sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <a href="/" class="text-2xl font-bold text-emerald-500">NPOS</a>
                <nav class="flex gap-2 text-sm">
                    <a href="/" class="px-3 py-1 rounded hover:bg-gray-700">Hlavní stránka</a>
                    <a href="/framework" class="px-3 py-1 rounded hover:bg-gray-700">Framework</a>
                    <a href="/knowledge" class="px-3 py-1 rounded hover:bg-gray-700">Znalosti</a>
                    <a href="/presets" class="px-3 py-1 rounded hover:bg-gray-700">Předlohy</a>
                    <a href="http://localhost:8501" target="_blank" class="px-3 py-1 rounded bg-emerald-700 text-white">Nástroje</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 py-8">
        <article>
            <h1 class="text-4xl font-bold mb-6 text-emerald-400">{page?.title}</h1>
            <div class="prose dark:prose-invert max-w-none" set:html={page?.content || ''} />
        </article>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 border-t border-gray-700 py-6 text-center text-gray-400">
        <p>Neurofunk Production OS | NPOS v0.1.0</p>
    </footer>
</body>
</html>
