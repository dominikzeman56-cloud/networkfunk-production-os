---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { paths } from '../../lib/config';

const knowledgeDir = paths.knowledge;
const knowledgeFiles = fs.readdirSync(knowledgeDir)
  .filter(f => f.endsWith('.md') && !f.startsWith('Index'))
  .map(f => {
    const filePath = path.join(knowledgeDir, f);
    const content = fs.readFileSync(filePath, 'utf8');
    const titleMatch = content.match(/^#\s+(.+)$/m);
    return {
      slug: f.replace('.md', ''),
      title: titleMatch ? titleMatch[1] : f.replace('.md', ''),
      excerpt: content.replace(/^#.*$/m, '').replace(/^\s*---\s*/, '').trim().slice(0, 140).trim() + '…'
    };
  });
---

<Layout title="Znalosti" module="KNOWLEDGE">
    <div class="hud-page-head">
        <div>
            <div class="hud-eyebrow">ENGINEERING KNOWLEDGE</div>
            <div class="hud-page-title">Knowledge Base</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px;">
        {knowledgeFiles.map(k => (
            <a href={`/knowledge/${k.slug}`} class="card elev-sm" style="text-decoration: none; color: inherit;">
                <span class="card-kicker">Knowledge</span>
                <span class="card-title">{k.title}</span>
                <p class="card-body">{k.excerpt}</p>
            </a>
        ))}
    </div>
</Layout>
