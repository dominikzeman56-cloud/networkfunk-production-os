---
import Layout from '../layouts/Layout.astro';

const currentTrack = {
  name: 'Neonlight Reflux',
  artist: 'Vlastní projekt',
  version: 'v1',
  stage: 'Aranžmá',
  stageIdx: 2,
  goal: 'Opravit Bass Movement',
  problem: 'Slabý low-end v dropu',
  reference: { track: 'Static', artist: 'Burr Oak' },
  sessionFocus: 'ARRANGEMENT',
};

const sessionSteps = ['Sound Design', 'Arrangement', 'Mixing', 'Mastering', 'Export'];
const activeStep = 'Arrangement';

const bars = Array.from({ length: 24 }, (_, i) => 6 + Math.round(Math.abs(Math.sin(i * 0.7)) * 30));
---

<Layout title="Dashboard" module="DASHBOARD" bpm="174" trackKey="Fm">
    <div class="hud-page-head">
        <div>
            <div class="hud-eyebrow">PRODUCTION HOME · SESSION HUD</div>
            <div class="hud-page-title">Current Track</div>
        </div>
        <div class="hud-stage">STAGE {currentTrack.stageIdx + 1} / 5 · {currentTrack.stage.toUpperCase()}</div>
    </div>

    <div class="dash-hero-grid">
        <div class="hud-hero-card">
            <div class="hud-bracket tl"></div>
            <div class="hud-bracket tr"></div>
            <div class="hud-bracket bl"></div>
            <div class="hud-bracket br"></div>

            <div class="dash-fields-grid">
                <div>
                    <div class="hud-field-label">TRACK</div>
                    <div class="hud-field-value">{currentTrack.name}</div>
                </div>
                <div>
                    <div class="hud-field-label">ARTIST</div>
                    <div class="hud-field-value">{currentTrack.artist}</div>
                </div>
                <div>
                    <div class="hud-field-label">VERSION</div>
                    <div class="hud-field-value" style="font-variant-numeric: tabular-nums;">{currentTrack.version}</div>
                </div>
                <div>
                    <div class="hud-field-label">TEMPO / KEY</div>
                    <div class="hud-field-value" style="font-variant-numeric: tabular-nums;">174 · Fm</div>
                </div>
            </div>

            <div style="height: 1px; background: linear-gradient(90deg, var(--color-accent-700), transparent); margin-bottom: 16px;"></div>

            <div class="dash-goal-grid">
                <div>
                    <div class="hud-field-label">TODAY'S GOAL</div>
                    <div style="font-size: 14px; line-height: 1.5;">{currentTrack.goal}</div>
                </div>
                <div>
                    <div class="hud-field-label">CURRENT PROBLEM</div>
                    <div style="font-size: 14px; line-height: 1.5; color: var(--color-accent-300);">{currentTrack.problem}</div>
                </div>
            </div>
        </div>

        <div class="hud-panel">
            <div class="hud-panel-label">REFERENCE ON DECK</div>
            <div style="font-family: var(--font-heading); font-size: 18px; margin-bottom: 4px;">{currentTrack.reference.track}</div>
            <div style="font-size: 12px; color: var(--color-neutral-300); margin-bottom: 16px;">{currentTrack.reference.artist}</div>
            <div class="hud-bars" style="margin-bottom: 16px;">
                {bars.map(h => <div class="bar" style={`height:${h}px`}></div>)}
            </div>
            <span class="tag tag-accent">SESSION FOCUS: {currentTrack.sessionFocus}</span>
        </div>
    </div>

    <div class="dash-stats-grid">
        <div class="hud-panel">
            <div class="hud-panel-label">SESSION STATUS</div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px;">
                {sessionSteps.map(step => (
                    <span class={`tag ${step === activeStep ? 'tag-accent' : 'tag-neutral'}`}>{step}</span>
                ))}
            </div>
            <div style="font-size: 12px; color: var(--color-neutral-300);">Last step: intro riser automation</div>
            <div style="font-size: 12px; color: var(--color-text);">Next: rebuild drop transient layer</div>
        </div>

        <div class="hud-panel">
            <div class="hud-panel-label">RECENT NOTES</div>
            <div style="font-size: 12px; margin-bottom: 8px;"><span style="color: var(--color-accent-300);">Breakthrough —</span> parallel comb filter fixed Reese phase smear.</div>
            <div style="font-size: 12px;"><span style="color: var(--color-neutral-300);">Issue —</span> snare buried under mid bass in chorus.</div>
        </div>

        <div class="hud-panel">
            <div class="hud-panel-label">DAILY PRIORITIES</div>
            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
                <div>▣ Review yesterday's progress</div>
                <div>▣ Set one session objective</div>
                <div>▢ Load reference track</div>
                <div>▢ Define next concrete step</div>
                <div>▢ Save progress before leaving</div>
            </div>
        </div>
    </div>

    <div class="hud-panel" style="margin-top: 20px;">
        <div class="hud-panel-label">FAST ACTIONS</div>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            <a href="/build-sheet" class="btn btn-secondary" style="font-size: 12px;">01 · Start New Project</a>
            <a href="/session" class="btn btn-secondary" style="font-size: 12px;">02 · Plan the Session</a>
            <a href="/producer" class="btn btn-secondary" style="font-size: 12px;">03 · Producer Philosophy</a>
            <a href="/presets" class="btn btn-secondary" style="font-size: 12px;">04 · Analyse Reference Preset</a>
            <a href="/session/Weekly-Review" class="btn btn-secondary" style="font-size: 12px;">05 · Weekly Review</a>
            <button class="btn btn-ghost" disabled style="font-size: 12px;">06 · Ask AI for Next Step</button>
        </div>
    </div>
</Layout>

<style>
    .dash-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-bottom: 20px; }
    .dash-fields-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
    .dash-goal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .dash-stats-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }

    @media (max-width: 900px) {
        .dash-hero-grid { grid-template-columns: 1fr; }
        .dash-stats-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
        .dash-fields-grid { grid-template-columns: 1fr 1fr; }
        .dash-goal-grid { grid-template-columns: 1fr; }
    }
</style>
