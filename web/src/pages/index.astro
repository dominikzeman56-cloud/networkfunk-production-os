---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';

const sessionRaw = fs.readFileSync('D:/ObsidianVault/networkfunk-production-os/data/session.json', 'utf8');
const session = JSON.parse(sessionRaw);
const project = session.projects[session.currentProject];

// Load recent server-side session logs
let recentLogs: any[] = [];
try {
  const dir = 'D:/ObsidianVault/networkfunk-production-os/data/sessions';
  if (fs.existsSync(dir)) {
    recentLogs = fs.readdirSync(dir)
      .filter((f: string) => f.endsWith('.json'))
      .sort().reverse().slice(0, 5)
      .map((f: string) => {
        try { return JSON.parse(fs.readFileSync(dir + '/' + f, 'utf8')); }
        catch { return null; }
      }).filter(Boolean);
  }
} catch {}

const bars = Array.from({ length: 24 }, (_, i) => 6 + Math.round(Math.abs(Math.sin(i * 0.7)) * 30));
---

<Layout title="Dashboard" module="DASHBOARD" bpm={String(project.tempo)} trackKey={project.key}>
    <div class="hud-page-head">
        <div>
            <div class="hud-eyebrow">PRODUCTION HOME · SESSION HUD</div>
            <div class="hud-page-title">Current Track</div>
        </div>
        <div class="hud-stage">STAGE {project.stageIdx + 1} / {project.totalStages} · {project.stage.toUpperCase()}</div>
    </div>

    <div class="dash-hero-grid">
        <div class="hud-hero-card">
            <div class="hud-bracket tl"></div>
            <div class="hud-bracket tr"></div>
            <div class="hud-bracket bl"></div>
            <div class="hud-bracket br"></div>

            <div class="dash-fields-grid">
                <div>
                    <div class="hud-field-label">TRACK</div>
                    <div class="hud-field-value">{project.name}</div>
                </div>
                <div>
                    <div class="hud-field-label">ARTIST</div>
                    <div class="hud-field-value">{project.artist}</div>
                </div>
                <div>
                    <div class="hud-field-label">VERSION</div>
                    <div class="hud-field-value" style="font-variant-numeric: tabular-nums;">{project.version}</div>
                </div>
                <div>
                    <div class="hud-field-label">TEMPO / KEY</div>
                    <div class="hud-field-value" style="font-variant-numeric: tabular-nums;">{project.tempo} · {project.key}</div>
                </div>
            </div>

            <div style="height: 1px; background: linear-gradient(90deg, var(--color-accent-700), transparent); margin-bottom: 16px;"></div>

            <div class="dash-goal-grid">
                <div>
                    <div class="hud-field-label">TODAY'S GOAL</div>
                    <div style="font-size: 14px; line-height: 1.5;">{project.goal}</div>
                </div>
                <div>
                    <div class="hud-field-label">CURRENT PROBLEM</div>
                    <div style="font-size: 14px; line-height: 1.5; color: var(--color-accent-300);">{project.problem}</div>
                </div>
            </div>
        </div>

        <div class="hud-panel">
            <div class="hud-panel-label">REFERENCE ON DECK</div>
            <div style="font-family: var(--font-heading); font-size: 18px; margin-bottom: 4px;">{project.reference.track}</div>
            <div style="font-size: 12px; color: var(--color-neutral-300); margin-bottom: 16px;">{project.reference.artist}</div>
            <div class="hud-bars" style="margin-bottom: 16px;">
                {bars.map(h => <div class="bar" style={`height:${h}px`}></div>)}
            </div>
            <span class="tag tag-accent">SESSION FOCUS: {project.sessionFocus}</span>
        </div>
    </div>

    <div class="dash-stats-grid">
        <div class="hud-panel">
            <div class="hud-panel-label">SESSION STATUS</div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px;">
                {project.stages.map((step: string) => (
                    <span class={`tag ${step === project.stage ? 'tag-accent' : 'tag-neutral'}`}>{step}</span>
                ))}
            </div>
            <div style="font-size: 12px; color: var(--color-neutral-300);">Last step: {project.lastStep}</div>
            <div style="font-size: 12px; color: var(--color-text);">Next: {project.nextStep}</div>
        </div>

        <div class="hud-panel">
            <div class="hud-panel-label">RECENT NOTES</div>
            {project.notes.map((note: any) => (
                <div style="font-size: 12px; margin-bottom: 8px;">
                    <span style={`color: ${note.type === 'breakthrough' ? 'var(--color-accent-300)' : 'var(--color-neutral-300)'};`}>
                        {note.type === 'breakthrough' ? 'Breakthrough' : 'Issue'} —
                    </span>
                    {note.text}
                </div>
            ))}
        </div>

        <div class="hud-panel">
            <div class="hud-panel-label">DAILY PRIORITIES</div>
            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
                {project.priorities.map((p: any) => (
                    <div>{p.done ? '▣' : '▢'} {p.text}</div>
                ))}
            </div>
        </div>
    </div>

    <div class="dash-bottom-grid">
        <div class="hud-panel">
            <div class="hud-panel-label">AI MENTOR</div>
            <div id="ai-output" style="font-size: 13px; line-height: 1.6; min-height: 60px; color: var(--color-neutral-400);">
                Click "Ask AI" to get a concrete next step based on your project context.
            </div>
            <div style="display: flex; gap: 8px; margin-top: 10px;">
                <button class="btn btn-primary" id="btn-ai-ask" style="font-size: 12px;">⚡ Ask AI for Next Step</button>
                <button class="btn btn-ghost" id="btn-ai-notes" style="font-size: 11px;">Add project notes to context</button>
            </div>
        </div>

        <div class="hud-panel">
            <div class="hud-panel-label">RECENT SESSIONS</div>
            <div id="recent-sessions">
                {recentLogs.length > 0 ? recentLogs.slice(0, 3).map((log: any) => (
                    <div class="dash-session-entry">
                        <span class="dash-session-date">{new Date(log.date || log.createdAt).toLocaleDateString('cs-CZ')}</span>
                        <span class="dash-session-work">{log.workDone || '—'}</span>
                    </div>
                )) : <div style="font-size: 12px; color: var(--color-neutral-500);">No sessions logged yet</div>}
            </div>
            <a href="/log" class="btn btn-secondary" style="font-size: 11px; margin-top: 10px;">+ Log Session</a>
        </div>
    </div>

    <div class="hud-panel" style="margin-top: 20px;">
        <div class="hud-panel-label">FAST ACTIONS</div>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            <a href="/build-sheet" class="btn btn-secondary" style="font-size: 12px;">01 · Start New Project</a>
            <a href="/session" class="btn btn-secondary" style="font-size: 12px;">02 · Plan the Session</a>
            <a href="/log" class="btn btn-secondary" style="font-size: 12px;">03 · Log Session</a>
            <a href="/producer" class="btn btn-secondary" style="font-size: 12px;">04 · Producer Philosophy</a>
            <a href="/presets" class="btn btn-secondary" style="font-size: 12px;">05 · Analyse Reference Preset</a>
            <a href="/session/Weekly-Review" class="btn btn-secondary" style="font-size: 12px;">06 · Weekly Review</a>
        </div>
    </div>
</Layout>

<script>
  const API = 'http://localhost:3099';

  const btnAsk = document.getElementById('btn-ai-ask');
  const aiOutput = document.getElementById('ai-output');

  // Load session context
  let notesCache = [];

  async function loadContext() {
    try {
      const r = await fetch(`${API}/api/session`);
      if (!r.ok) return;
      const data = await r.json();
      const p = data.projects?.[data.currentProject];
      if (p) {
        notesCache = p.notes?.map((n: any) => n.text) || [];
        // Prefill context for AI
        btnAsk.dataset.project = p.name || 'Unknown';
        btnAsk.dataset.stage = p.stage || 'Unknown';
        btnAsk.dataset.goal = p.goal || '';
        btnAsk.dataset.problem = p.problem || '';
      }
    } catch {}
  }

  btnAsk?.addEventListener('click', async () => {
    aiOutput.textContent = 'Thinking...';
    aiOutput.style.color = 'var(--color-accent-300)';
    btnAsk.disabled = true;

    try {
      const r = await fetch(`${API}/api/ai-next-step`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          project: btnAsk.dataset.project || 'Unknown',
          stage: btnAsk.dataset.stage || 'Unknown',
          goal: btnAsk.dataset.goal || 'No goal set',
          problem: btnAsk.dataset.problem || 'None',
          notes: notesCache,
        }),
      });

      if (!r.ok) {
        const err = await r.json();
        aiOutput.innerHTML = `<span style="color: var(--color-neutral-400);">${err.hint || err.error || 'Server error — is ANTHROPIC_API_KEY set?'}</span>`;
        return;
      }

      const data = await r.json();
      aiOutput.innerHTML = data.step.replace(/\n/g, '<br>');
      aiOutput.style.color = 'var(--color-text)';
    } catch {
      aiOutput.innerHTML = `<span style="color: var(--color-neutral-400);">Server offline. Start the API: <code style="font-size: 11px;">cd server && npm start</code></span>`;
    } finally {
      btnAsk.disabled = false;
    }
  });

  document.getElementById('btn-ai-notes')?.addEventListener('click', () => {
    const note = prompt('Add a note about current session (what you just did / what changed):');
    if (note) {
      notesCache.push(note);
      aiOutput.textContent = `✓ Note added: "${note}"`;
      aiOutput.style.color = 'var(--color-accent-300)';
    }
  });

  // Load context on mount
  loadContext();
</script>

<style>
    .dash-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-bottom: 20px; }
    .dash-fields-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
    .dash-goal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .dash-stats-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
    .dash-bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }

    .dash-session-entry { display: flex; gap: 10px; font-size: 12px; padding: 6px 0; border-bottom: 1px solid var(--color-neutral-800); }
    .dash-session-entry:last-child { border-bottom: none; }
    .dash-session-date { color: var(--color-neutral-400); white-space: nowrap; font-variant-numeric: tabular-nums; min-width: 80px; }
    .dash-session-work { color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    @media (max-width: 900px) {
        .dash-hero-grid { grid-template-columns: 1fr; }
        .dash-stats-grid { grid-template-columns: 1fr; }
        .dash-bottom-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
        .dash-fields-grid { grid-template-columns: 1fr 1fr; }
        .dash-goal-grid { grid-template-columns: 1fr; }
    }
</style>
