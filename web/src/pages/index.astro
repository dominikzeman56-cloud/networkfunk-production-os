---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import { paths } from '../lib/config';

const sessionRaw = fs.readFileSync(paths.sessionFile, 'utf8');
const session = JSON.parse(sessionRaw);
const project = session.projects[session.currentProject];

let recentLogs: any[] = [];
try {
  const dir = paths.sessions;
  if (fs.existsSync(dir)) {
    recentLogs = fs.readdirSync(dir)
      .filter((f: string) => f.endsWith('.json'))
      .sort().reverse().slice(0, 5)
      .map((f: string) => {
        try { return JSON.parse(fs.readFileSync(dir + '/' + f, 'utf8')); }
        catch { return null; }
      }).filter(Boolean);
  }
} catch {}

const STAGES: string[] = project.stages || ["Sound Design", "Arrangement", "Mixing", "Mastering", "Export"];
const currentStage: string = project.stage || STAGES[0];
const currentStageIdx = STAGES.indexOf(currentStage);

const bars = Array.from({ length: 24 }, (_, i) => 6 + Math.round(Math.abs(Math.sin(i * 0.7)) * 30));
---

<Layout title="Dashboard" module="DASHBOARD" bpm={String(project.tempo)} trackKey={project.key}>

  <!-- ── PAGE HEADER ── -->
  <div class="hud-page-head">
    <div>
      <div class="hud-eyebrow">PRODUCTION HOME · SESSION HUD</div>
      <div class="hud-page-title">Dashboard</div>
    </div>
    <div class="hud-stage">STAGE {currentStageIdx + 1} / {STAGES.length} · {currentStage.toUpperCase()}</div>
  </div>

  <!-- ── HERO: CURRENT TRACK + REFERENCE ── -->
  <div class="dash-hero-grid hud-stagger">
    <div class="hud-hero-card">
      <div class="hud-bracket tl"></div>
      <div class="hud-bracket tr"></div>
      <div class="hud-bracket bl"></div>
      <div class="hud-bracket br"></div>
      <div class="dash-fields-grid">
        <div>
          <div class="hud-field-label">TRACK</div>
          <div class="hud-field-value">{project.name}</div>
        </div>
        <div>
          <div class="hud-field-label">ARTIST</div>
          <div class="hud-field-value">{project.artist}</div>
        </div>
        <div>
          <div class="hud-field-label">VERSION</div>
          <div class="hud-field-value" style="font-variant-numeric: tabular-nums;">{project.version}</div>
        </div>
        <div>
          <div class="hud-field-label">TEMPO / KEY</div>
          <div class="hud-field-value" style="font-variant-numeric: tabular-nums;">{project.tempo} · {project.key}</div>
        </div>
      </div>
      <div style="height: 1px; background: linear-gradient(90deg, var(--color-accent-700), transparent); margin-bottom: 16px;"></div>
      <div class="dash-goal-grid">
        <div>
          <div class="hud-field-label">TODAY'S GOAL</div>
          <div style="font-size: 14px; line-height: 1.5;">{project.goal}</div>
        </div>
        <div>
          <div class="hud-field-label">CURRENT PROBLEM</div>
          <div style="font-size: 14px; line-height: 1.5; color: var(--color-accent-300);">{project.problem}</div>
        </div>
      </div>
    </div>

    <div class="hud-panel">
      <div class="hud-panel-label">REFERENCE ON DECK</div>
      <div style="font-family: var(--font-heading); font-size: 18px; margin-bottom: 4px;">{project.reference.track}</div>
      <div style="font-size: 12px; color: var(--color-neutral-300); margin-bottom: 16px;">{project.reference.artist}</div>
      <div class="hud-bars" style="margin-bottom: 16px;">
        {bars.map(h => <div class="bar" style={`height:${h}px`}></div>)}
      </div>
      <span class="tag tag-accent">SESSION FOCUS: {project.sessionFocus}</span>
    </div>
  </div>

  <!-- ── PROGRESS STEPPER ── -->
  <div class="hud-panel hud-stagger" style="margin-bottom: 20px;">
    <div class="hud-panel-label">PRODUCTION STAGE</div>
    <div class="stage-stepper">
      {STAGES.map((stage, i) => {
        const done = i < currentStageIdx;
        const active = i === currentStageIdx;
        return (
          <div class="stage-step-wrap">
            <div class={`stage-step ${active ? 'active' : done ? 'done' : 'upcoming'}`}>
              <div class="stage-dot"></div>
              <span class="stage-label">{stage.toUpperCase()}</span>
              {active && <span class="stage-badge">CURRENT</span>}
              {done && <span class="stage-badge done-badge">DONE</span>}
            </div>
            {i < STAGES.length - 1 && <div class={`stage-connector ${done ? 'done' : ''}`}></div>}
          </div>
        );
      })}
    </div>
    <div class="dash-step-grid" style="margin-top: 14px;">
      <div class="step-info" style="border-color: rgba(145,132,217,0.3);">
        <div class="hud-field-label">LAST SESSION</div>
        <div style="font-size: 12px; line-height: 1.5;">{project.lastStep}</div>
      </div>
      <div class="step-info" style="border-color: rgba(0,240,255,0.3);">
        <div class="hud-field-label">NEXT STEP</div>
        <div style="font-size: 12px; line-height: 1.5;">{project.nextStep}</div>
      </div>
    </div>
  </div>

  <!-- ── PRIORITIES + NOTES + SESSIONS ── -->
  <div class="dash-stats-grid hud-stagger">

    <!-- Daily Priorities (interactive) -->
    <div class="hud-panel">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
        <div class="hud-panel-label" style="margin-bottom: 0;">DAILY PRIORITIES</div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <span id="priority-count" class="mono-badge">{project.priorities.filter((p: any) => p.done).length}/{project.priorities.length}</span>
          <div class="progress-bar-wrap">
            <div id="priority-bar" class="progress-bar-fill" style={`width: ${project.priorities.length ? (project.priorities.filter((p: any) => p.done).length / project.priorities.length * 100) : 0}%`}></div>
          </div>
        </div>
      </div>
      <div id="priority-list" class="priority-list">
        {project.priorities.map((p: any, i: number) => (
          <button class={`priority-item ${p.done ? 'done' : ''}`} data-index={i}>
            <div class={`priority-check ${p.done ? 'checked' : ''}`}>
              {p.done && (
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                  <polyline points="1.5,5 4,7.5 8.5,2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </div>
            <span class="priority-text">{p.text}</span>
            {p.tag && <span class="priority-tag">{p.tag}</span>}
          </button>
        ))}
      </div>
    </div>

    <!-- Recent Notes -->
    <div class="hud-panel">
      <div class="hud-panel-label">RECENT NOTES</div>
      <div class="notes-list">
        {project.notes.map((note: any) => {
          const color = note.type === 'breakthrough' ? 'var(--color-accent-300)' : note.type === 'issue' ? '#ff6b6b' : '#ffaa00';
          const label = note.type === 'breakthrough' ? 'BREAKTHROUGH' : note.type === 'issue' ? 'ISSUE' : 'IDEA';
          return (
            <div class="note-item">
              <span class="note-badge" style={`border-color: ${color}55; color: ${color};`}>{label}</span>
              <div style="flex: 1; min-width: 0;">
                <div style="font-size: 11px; line-height: 1.5; color: var(--color-text);">{note.text}</div>
                {note.time && <div style="font-size: 10px; color: var(--color-neutral-500); margin-top: 2px; font-family: var(--font-mono);">{note.time}</div>}
              </div>
            </div>
          );
        })}
        {project.notes.length === 0 && <div style="font-size: 12px; color: var(--color-neutral-500);">No notes yet.</div>}
      </div>
    </div>

    <!-- Recent Sessions -->
    <div class="hud-panel">
      <div class="hud-panel-label">RECENT SESSIONS</div>
      <div>
        {recentLogs.length > 0 ? recentLogs.slice(0, 4).map((log: any) => (
          <div class="dash-session-entry">
            <span class="dash-session-date">{new Date(log.date || log.createdAt).toLocaleDateString('cs-CZ')}</span>
            <span class="dash-session-work">{log.workDone || '—'}</span>
          </div>
        )) : <div style="font-size: 12px; color: var(--color-neutral-500);">No sessions logged yet</div>}
      </div>
      <a href="/log" class="btn btn-secondary" style="font-size: 11px; margin-top: 12px;">+ Log Session</a>
    </div>
  </div>

  <!-- ── AI MENTOR ── -->
  <div class="hud-panel hud-stagger" style="margin-top: 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
      <div class="hud-panel-label" style="margin-bottom: 0;">AI MENTOR</div>
      <span style="font-size: 9px; letter-spacing: 0.1em; color: var(--color-neutral-500); border: 1px solid var(--color-neutral-800); padding: 2px 8px; font-family: var(--font-mono);">PRODUCTION MENTOR MODE</span>
    </div>
    <div id="ai-output" class="mentor-output">
      Click "Ask AI" to get a concrete next step based on your project context.
    </div>
    <div style="display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap;">
      <input id="mentor-input" type="text" class="input mentor-input" placeholder="e.g. My sub feels weak against the kick — what's the decision tree?" />
      <button class="btn btn-primary hud-breathe" id="btn-ai-ask" style="font-size: 12px; white-space: nowrap;">⚡ Ask AI</button>
    </div>
    <div style="display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap;">
      {["What should I do next?", "Weak sub against kick", "How do I fix muddy mids?", "Arrange Drop B"].map(q => (
        <button class="mentor-quick" data-q={q}>{q}</button>
      ))}
    </div>
  </div>

  <!-- ── FAST ACTIONS ── -->
  <div class="hud-glow-divider" style="margin: 24px 0;"></div>
  <div class="hud-panel hud-stagger">
    <div class="hud-panel-label">FAST ACTIONS</div>
    <div class="fast-actions-grid">
      {[
        { href: '/build-sheet', label: 'New Project', sub: '⌘N', icon: 'plus', color: 'var(--color-accent)' },
        { href: '/build-sheet', label: 'Build Sheet', sub: '⌘B', icon: 'file', color: 'var(--color-cyan)' },
        { href: '/presets', label: 'Preset Browser', sub: '⌘P', icon: 'sliders', color: 'var(--color-accent-2)' },
        { href: '/knowledge', label: 'Knowledge Base', sub: '⌘K', icon: 'book', color: 'var(--color-cyan)' },
        { href: '/session', label: 'Plan Session', sub: '⌘S', icon: 'target', color: 'var(--color-accent)' },
        { href: '/log', label: 'Log Session', sub: '⌘L', icon: 'clock', color: 'var(--color-accent-2)' },
      ].map(action => (
        <a href={action.href} class="fast-action-btn">
          <div class="fast-action-icon" style={`border-color: ${action.color}33;`}>
            {action.icon === 'plus' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={action.color} stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>}
            {action.icon === 'file' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={action.color} stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>}
            {action.icon === 'sliders' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={action.color} stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>}
            {action.icon === 'book' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={action.color} stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>}
            {action.icon === 'target' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={action.color} stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>}
            {action.icon === 'clock' && <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={action.color} stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
          </div>
          <div style="font-size: 11px; color: var(--color-neutral-400); text-align: center; line-height: 1.3;">{action.label}</div>
          <span class="fast-action-kbd">{action.sub}</span>
        </a>
      ))}
    </div>
  </div>

</Layout>

<script>
  const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:3099';

  // ── Priority checklist ──
  const priorityItems = document.querySelectorAll<HTMLButtonElement>('.priority-item');
  const priorityCount = document.getElementById('priority-count');
  const priorityBar = document.getElementById('priority-bar') as HTMLElement | null;

  function updateProgress() {
    const total = priorityItems.length;
    const done = document.querySelectorAll('.priority-item.done').length;
    if (priorityCount) priorityCount.textContent = `${done}/${total}`;
    if (priorityBar) priorityBar.style.width = total ? `${(done / total) * 100}%` : '0%';
  }

  priorityItems.forEach(item => {
    item.addEventListener('click', () => {
      const isDone = item.classList.toggle('done');
      const check = item.querySelector('.priority-check');
      if (check) {
        check.classList.toggle('checked', isDone);
        const svg = check.querySelector('svg');
        if (isDone && !svg) {
          check.innerHTML = `<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><polyline points="1.5,5 4,7.5 8.5,2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        } else if (!isDone && svg) {
          svg.remove();
        }
      }
      updateProgress();
    });
  });

  // ── AI Mentor ──
  const btnAsk = document.getElementById('btn-ai-ask') as HTMLButtonElement | null;
  const aiOutput = document.getElementById('ai-output');
  const mentorInput = document.getElementById('mentor-input') as HTMLInputElement | null;

  let notesCache: string[] = [];
  let projectCtx = { project: '', stage: '', goal: '', problem: '' };

  async function loadContext() {
    try {
      const r = await fetch(`${API}/api/session`);
      if (!r.ok) return;
      const data = await r.json();
      const p = data.projects?.[data.currentProject];
      if (p) {
        notesCache = p.notes?.map((n: any) => n.text) || [];
        projectCtx = { project: p.name || '', stage: p.stage || '', goal: p.goal || '', problem: p.problem || '' };
      }
    } catch {}
  }

  async function askMentor(question?: string) {
    if (!aiOutput) return;
    aiOutput.textContent = 'Processing...';
    aiOutput.style.color = 'var(--color-accent-300)';
    if (btnAsk) btnAsk.disabled = true;

    try {
      const r = await fetch(`${API}/api/ai-next-step`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...projectCtx,
          notes: notesCache,
          question: question || mentorInput?.value || '',
        }),
      });
      if (!r.ok) {
        const err = await r.json();
        aiOutput.innerHTML = `<span style="color: var(--color-neutral-400);">${err.hint || err.error || 'Server error'}</span>`;
        return;
      }
      const data = await r.json();
      aiOutput.innerHTML = data.step.replace(/\n/g, '<br>');
      aiOutput.style.color = 'var(--color-text)';
      if (mentorInput) mentorInput.value = '';
    } catch {
      aiOutput.innerHTML = `<span style="color: var(--color-neutral-400);">Server offline. Start: <code>cd server && npm start</code></span>`;
      aiOutput.style.color = '';
    } finally {
      if (btnAsk) btnAsk.disabled = false;
    }
  }

  btnAsk?.addEventListener('click', () => askMentor());
  mentorInput?.addEventListener('keydown', e => { if (e.key === 'Enter') askMentor(); });

  document.querySelectorAll<HTMLButtonElement>('.mentor-quick').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = btn.dataset.q || '';
      if (mentorInput) mentorInput.value = q;
      askMentor(q);
    });
  });

  loadContext();
</script>

<style>
  /* ── Layout grids ── */
  .dash-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-bottom: 20px; }
  .dash-fields-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
  .dash-goal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .dash-stats-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-top: 20px; }
  .dash-step-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  /* ── Stage stepper ── */
  .stage-stepper { display: flex; align-items: center; flex-wrap: wrap; }
  .stage-step-wrap { display: flex; align-items: center; }
  .stage-step {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: 10px 16px; border: 1px solid transparent;
    min-width: 100px; text-align: center;
    transition: border-color 0.2s, background 0.2s;
  }
  .stage-step.active { border-color: var(--color-accent); background: rgba(145,132,217,0.06); }
  .stage-step.done { border-color: rgba(145,132,217,0.2); }
  .stage-step.upcoming { border-color: var(--color-neutral-800); }
  .stage-dot {
    width: 8px; height: 8px; border: 1px solid;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .stage-step.active .stage-dot { border-color: var(--color-accent); background: transparent; box-shadow: 0 0 6px var(--color-accent); }
  .stage-step.done .stage-dot { border-color: var(--color-accent); background: var(--color-accent); }
  .stage-step.upcoming .stage-dot { border-color: var(--color-neutral-700); }
  .stage-label { font-size: 9px; letter-spacing: 0.12em; font-family: var(--font-mono); }
  .stage-step.active .stage-label { color: var(--color-accent); }
  .stage-step.done .stage-label { color: var(--color-accent-500); }
  .stage-step.upcoming .stage-label { color: var(--color-neutral-600); }
  .stage-badge { font-size: 8px; letter-spacing: 0.1em; color: var(--color-neutral-500); font-family: var(--font-mono); }
  .stage-badge.done-badge { color: rgba(145,132,217,0.5); }
  .stage-connector { height: 1px; width: 20px; flex-shrink: 0; background: var(--color-neutral-800); }
  .stage-connector.done { background: rgba(145,132,217,0.3); }
  .step-info { border-left: 2px solid; padding-left: 12px; }

  /* ── Priority checklist ── */
  .mono-badge { font-size: 11px; font-family: var(--font-mono); color: var(--color-accent); }
  .progress-bar-wrap { width: 72px; height: 4px; background: var(--color-neutral-800); border-radius: 2px; overflow: hidden; }
  .progress-bar-fill { height: 100%; background: var(--color-accent); box-shadow: 0 0 4px var(--color-accent); border-radius: 2px; transition: width 0.3s; }
  .priority-list { display: flex; flex-direction: column; }
  .priority-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 0; border: none; background: transparent;
    cursor: pointer; text-align: left; width: 100%;
    border-bottom: 1px solid var(--color-neutral-800);
    transition: background 0.1s;
  }
  .priority-item:last-child { border-bottom: none; }
  .priority-item:hover { background: rgba(145,132,217,0.04); }
  .priority-check {
    width: 16px; height: 16px; flex-shrink: 0;
    border: 1px solid var(--color-neutral-600);
    display: flex; align-items: center; justify-content: center;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    color: var(--color-accent);
  }
  .priority-check.checked {
    border-color: var(--color-accent);
    background: rgba(145,132,217,0.1);
    box-shadow: 0 0 6px rgba(145,132,217,0.3);
  }
  .priority-text { font-size: 11px; flex: 1; color: var(--color-text); line-height: 1.4; transition: color 0.2s; text-align: left; }
  .priority-item.done .priority-text { color: var(--color-neutral-600); text-decoration: line-through; }
  .priority-tag { font-size: 8px; letter-spacing: 0.1em; color: var(--color-neutral-500); border: 1px solid var(--color-neutral-800); padding: 1px 5px; font-family: var(--font-mono); white-space: nowrap; }

  /* ── Notes ── */
  .notes-list { display: flex; flex-direction: column; gap: 10px; }
  .note-item { display: flex; gap: 8px; align-items: flex-start; }
  .note-badge { font-size: 8px; letter-spacing: 0.1em; border: 1px solid; padding: 2px 6px; font-family: var(--font-mono); white-space: nowrap; margin-top: 2px; flex-shrink: 0; }

  /* ── Session log ── */
  .dash-session-entry {
    display: flex; gap: 10px; font-size: 12px; padding: 8px 0;
    border-bottom: 1px solid var(--color-neutral-800);
    transition: background 0.1s, padding-left 0.1s;
  }
  .dash-session-entry:last-child { border-bottom: none; }
  .dash-session-entry:hover { background: rgba(145,132,217,0.04); padding-left: 4px; }
  .dash-session-date { color: var(--color-neutral-400); white-space: nowrap; font-variant-numeric: tabular-nums; min-width: 80px; font-family: var(--font-mono); }
  .dash-session-work { color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* ── AI Mentor ── */
  .mentor-output {
    font-size: 13px; line-height: 1.6; min-height: 52px;
    color: var(--color-neutral-400); padding: 10px 12px;
    background: var(--color-neutral-900); border: 1px solid var(--color-neutral-800);
    border-radius: var(--radius-sm);
  }
  .mentor-input { flex: 1; min-width: 0; font-size: 12px; }
  .mentor-quick {
    font-size: 9px; letter-spacing: 0.05em; font-family: var(--font-mono);
    border: 1px solid var(--color-neutral-800); color: var(--color-neutral-500);
    background: transparent; padding: 3px 8px; cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .mentor-quick:hover { border-color: var(--color-neutral-600); color: var(--color-neutral-300); }

  /* ── Fast Actions ── */
  .fast-actions-grid {
    display: grid; grid-template-columns: repeat(6, 1fr);
