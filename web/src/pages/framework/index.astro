---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { paths } from '../../lib/config';

const frameworkDir = paths.framework;
const frameworkFiles = fs.readdirSync(frameworkDir)
  .filter(f => f.endsWith('.md') && !f.startsWith('Index'))
  .map(f => {
    const filePath = path.join(frameworkDir, f);
    const content = fs.readFileSync(filePath, 'utf8');
    const titleMatch = content.match(/^#\s+(.+)$/m);
    return {
      slug: f.replace('.md', ''),
      title: titleMatch ? titleMatch[1] : f.replace('.md', ''),
      excerpt: content.replace(/^#.*$/m, '').replace(/^\s*---\s*/, '').trim().slice(0, 140).trim() + '…'
    };
  });
---

<Layout title="Framework" module="FRAMEWORK">
    <div class="hud-page-head">
        <div>
            <div class="hud-eyebrow">DECISION SUPPORT</div>
            <div class="hud-page-title">Framework</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;">
        {frameworkFiles.map(f => (
            <a href={`/framework/${f.slug}`} class="card elev-sm" style="text-decoration: none; color: inherit;">
                <span class="card-kicker">Framework</span>
                <span class="card-title">{f.title}</span>
                <p class="card-body">{f.excerpt}</p>
            </a>
        ))}
    </div>
</Layout>
