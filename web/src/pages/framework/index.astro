---
// NPOS Framework Index - Česká verze
const title = "Framework - NPOS";

const fs = require('fs');
const path = require('path');

const frameworkDir = 'D:/ObsidianVault/networkfunk-production-os/Framework';
const frameworkFiles = fs.readdirSync(frameworkDir)
  .filter(f => f.endsWith('.md') && !f.startsWith('Index'))
  .map(f => {
    const filePath = path.join(frameworkDir, f);
    const content = fs.readFileSync(filePath, 'utf8');
    const titleMatch = content.match(/^#\s+(.+)$/m);
    return {
      slug: f.replace('.md', ''),
      title: titleMatch ? titleMatch[1] : f.replace('.md', ''),
      content: content.substring(0, 150) + '...'
    };
  });

const frameworkCategories = [
  { name: 'Decision Tree', slug: 'decision-tree' },
  { name: 'Workflow Map', slug: 'workflow-map' },
  { name: 'Checklists', slug: 'checklists' },
  { name: 'Reference Analysis', slug: 'reference-analysis-framework' },
  { name: 'Workflow', slug: 'workflow-map' },
];

const categoryMap: Record<string, string> = {
  'decision-tree': 'Strom rozhodování',
  'workflow-map': 'Workflow mapa',
  'checklists': 'Checklisty',
  'reference-analysis-framework': 'Rozbor referencí',
  'workflow': 'Workflow'
};
---

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root { --primary: #10b981; --primary-hover: #059669; }
        body { background-color: #0f172a; color: #f1f5f9; font-family: system-ui, sans-serif; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <header class="bg-gray-800 border-b border-gray-700 sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3">
            <div class="flex justify-between items-center">
                <a href="/" class="text-2xl font-bold text-emerald-500">NPOS</a>
                <nav class="flex gap-2 text-sm">
                    <a href="/" class="px-3 py-1 rounded hover:bg-gray-700">Hlavní stránka</a>
                    <a href="/framework" class="px-3 py-1 rounded bg-gray-700 text-white">Framework</a>
                    <a href="/knowledge" class="px-3 py-1 rounded hover:bg-gray-700">Znalosti</a>
                    <a href="/presets" class="px-3 py-1 rounded hover:bg-gray-700">Předlohy</a>
                    <a href="http://localhost:8501" target="_blank" class="px-3 py-1 rounded bg-emerald-700 text-white">Nástroje</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="flex-grow container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold mb-8 text-emerald-400">Framework</h1>

        <section class="mb-12">
            <h2 class="text-2xl font-bold mb-4 text-emerald-400">Frameworky a nástroje</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {frameworkFiles.map(f => (
                    <a href="/framework/{f.slug}" class="block p-4 bg-gray-800 rounded hover:bg-gray-700 transition border border-gray-700">
                        <h3 class="font-semibold text-emerald-400">{f.title}</h3>
                        <p class="text-sm text-gray-400 mt-1">{f.content}</p>
                    </a>
                ))}
            </div>
        </section>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-6 text-center text-gray-400">
        <p>Neurofunk Production OS | NPOS v0.1.0</p>
    </footer>
</body>
</html>
