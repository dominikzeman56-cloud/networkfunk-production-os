---
import '../styles/nocturne.css';
import '../styles/hud.css';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title: string;
  module: string;
  bpm?: string;
  trackKey?: string;
  autosave?: string;
  showMiniWave?: boolean;
}

const { title, module, bpm = '174', trackKey = 'Fm', autosave = '2m ago', showMiniWave = true } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const navItems = [
  { href: '/', label: 'DASHBOARD' },
  { href: '/build-sheet', label: 'BUILD SHEET' },
  { href: '/session', label: 'SESSION' },
  { href: '/producer', label: 'PRODUCER' },
  { href: '/framework', label: 'FRAMEWORK' },
  { href: '/knowledge', label: 'KNOWLEDGE' },
  { href: '/presets', label: 'PRESETS' },
  { href: '/log', label: 'LOG' },
];
---

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - NPOS</title>
</head>
<body>
    <div class="hud-app">
        <div class="hud-grid-layer"></div>
        <div class="hud-scanline-wrap"><div class="hud-scanline-sweep"></div></div>

        <div class="hud-topbar">
            <div class="hud-brand">
                <span class="hud-brand-dot"></span>
                <span class="hud-brand-name">NPOS<span class="slash">/</span><span class="ctrl">CTRL</span></span>
            </div>

            <nav class="hud-nav">
                {navItems.map(item => (
                    <a href={item.href} class="btn" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
                ))}
            </nav>

            <div class="hud-topright">
                <button id="search-trigger" class="btn btn-secondary" style="font-size: 11px; gap: 6px; padding: 4px 10px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                    </svg>
                    <span style="opacity: 0.6;">⌘K</span>
                </button>
                {showMiniWave && <canvas data-hud-miniwave width="120" height="28"></canvas>}
                <div class="hud-sync">
                    <span class="hud-sync-dot"></span>
                    SYNCED · <span data-hud-clock>--:--:--</span>
                </div>
            </div>
        </div>

        <div class="hud-statusbar">
            <span>MODULE // {module}</span>
            <span class="fill"></span>
            <span>BPM {bpm}</span>
            <span class="sep">|</span>
            <span>KEY {trackKey}</span>
            <span class="sep">|</span>
            <span>AUTOSAVE {autosave.toUpperCase()}</span>
            <span class="sep">|</span>
            <span class="link-ok">● LINK OK</span>
        </div>

        <div class="hud-content">
            <slot />
        </div>
    </div>

    <SearchModal />

    <script src="../scripts/hud.js"></script>
    <script is:inline>
      // Wire search trigger button
      document.getElementById('search-trigger')?.addEventListener('click', () => {
        document.getElementById('search-modal')?.removeAttribute('hidden');
        document.getElementById('search-input')?.focus();
      });
    </script>
</body>
</html>
